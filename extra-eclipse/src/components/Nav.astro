---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/reviews", label: "Writing" },
  { href: "/resume/MaddieBurroughsResume.pdf", label: "Resume", external: true },
];

const path = Astro.url.pathname;
---

<nav>
  <a class="brand" href="/">
    Maddie Burroughs
    <span class="tagline">designer && developer</span>
  </a>

  <ul>
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class={path === link.href ? "active" : ""}
          target={link.external ? "_blank" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1050;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    background-color: var(--bg);
    border-bottom: 5px solid var(--accent);
  }

  .brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.25rem;
    color: var(--accent);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--offwhite);
  }

  .tagline {
    font-size: 0.9rem;
    letter-spacing: normal;
  }

  ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    color: var(--offwhite);
    text-decoration-line: none;
    text-decoration-style: wavy;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  ul a.active {
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
  }

  ul a:hover:not(.active) {
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  @media (max-width: 600px) {
    nav {
      flex-direction: column;
      height: auto;
      gap: 0.5rem;
      padding: 1rem;
    }
  }
</style>
