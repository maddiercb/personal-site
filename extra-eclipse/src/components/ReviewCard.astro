---
const { title, venue, quote, cover, url } = Astro.props;
---

<figure class="polaroid">
  {/* Decorative: the production photo says nothing the title beside it doesn't. */}
  <img src={cover} alt="" class="cover" loading="lazy" />
  <figcaption>
    <span class="title">
      {/* ::after stretches this link over the whole card, so the card is
          clickable while the accessible name stays the review title. */}
      <a class="open" href={url} target="_blank" rel="noopener noreferrer">
        {title}<span class="sr-only"> — read the full review (opens in a new tab)</span>
      </a>
    </span>
    <span class="byline">{venue}</span>
    <p class="quote"><span class="mark" aria-hidden="true">&ldquo;</span>{quote}</p>
  </figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 22rem;
    max-width: 100%;
    margin: 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--offwhite);
    border-radius: 4px;
    box-shadow: 4px 6px 16px rgba(0, 0, 0, 0.45);
    transform: rotate(-1.5deg);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }

  .polaroid:nth-child(even) {
    transform: rotate(1.5deg);
  }

  .polaroid:hover {
    transform: rotate(0);
    box-shadow: 6px 10px 22px var(--accent);
  }

  .polaroid:has(.open:focus-visible) {
    transform: rotate(0);
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .cover {
    display: block;
    width: 100%;
    /* Holds the frame open before the remote image loads, so the row doesn't
       reflow around it. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
    background: #ddd;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    /* Cards in a wrapped flex row stretch to the tallest one; absorbing that
       here leaves the slack as bottom border rather than a ragged grid. */
    flex: 1;
    padding-top: 0.75rem;
    color: #1a1a1a;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.25;
  }

  .open {
    color: inherit;
    text-decoration: none;
  }

  .open::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .open:focus-visible {
    outline: none;
  }

  .byline {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: #555;
  }

  .quote {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.45;
    color: #333;
    /* Long pull quotes get cut rather than stretching one card past the rest —
       the card is a teaser, the full piece is a click away. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .mark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 0;
    vertical-align: -0.15em;
    color: var(--accent);
    margin-right: 0.1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
