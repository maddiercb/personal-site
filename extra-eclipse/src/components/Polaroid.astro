---
import { Image } from "astro:assets";

const { id, title, byline, cover, comingSoon } = Astro.props;
---

<figure class:list={["polaroid", { faded: comingSoon }]}>
  {comingSoon && <span class="ribbon">Coming Soon!</span>}
  <Image src={cover} alt={title} class="cover" widths={[400, 800]} sizes="360px" />
  <figcaption>
    <span class="title">
      {
        comingSoon ? (
          title
        ) : (
          /* ::after stretches this button over the whole card, so the card is
             clickable while the accessible name stays the project title. */
          <button type="button" class="open" data-open={id} aria-haspopup="dialog">
            {title}
          </button>
        )
      }
    </span>
    <span class="byline">{byline}</span>
  </figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    width: 22rem;
    max-width: 100%;
    margin: 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--offwhite);
    border-radius: 4px;
    box-shadow: 4px 6px 16px rgba(0, 0, 0, 0.45);
    transform: rotate(-1.5deg);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }

  .polaroid:nth-child(even) {
    transform: rotate(1.5deg);
  }

  .polaroid:hover {
    transform: rotate(0);
    box-shadow: 6px 10px 22px var(--accent);
  }

  .polaroid:has(.open:focus-visible) {
    transform: rotate(0);
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .cover {
    display: block;
    width: 100%;
    /* Astro's <Image> emits width/height attrs; without this the height attr
       wins and aspect-ratio is ignored, stretching the cover tall. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    padding-top: 0.75rem;
    color: #1a1a1a;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
  }

  .open {
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .open::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .open:focus-visible {
    outline: none;
  }

  .byline {
    font-size: 0.95rem;
    color: #555;
  }

  .faded {
    filter: saturate(0.85);
  }

  .ribbon {
    position: absolute;
    top: 18px;
    right: -30px;
    transform: rotate(45deg);
    background: var(--accent);
    color: #fff;
    padding: 5px 34px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.5px;
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }
</style>
